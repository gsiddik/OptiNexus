# Copy these keys into deploy/optiecosystem/.state/nexus.env (or root .env for a standalone Compose install).
# Use the SMTP token of a TRANSACTIONAL stream; never commit real values.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=30
MAIL_USERNAME=replace_with_smtp_access_key
MAIL_PASSWORD=replace_with_smtp_secret_key
MAIL_FROM_ADDRESS=notifications@your-verified-domain.example
MAIL_FROM_NAME=OptiNexus

# Operational e-mail behaviour (optional; defaults shown).
NOTIFICATION_MAIL_LOCALE=id
INVOICE_DUE_REMINDER_DAYS=3
# Bounce/spam-complaint webhook: choose a long random password, then in Postmark (Servers > your server > the transactional
# stream > Webhooks) add https://POSTMARK_WEBHOOK_USERNAME:POSTMARK_WEBHOOK_PASSWORD@<public Nexus API host>/api/v1/webhooks/postmark
# with Bounce, Spam Complaint and Subscription Change enabled.
POSTMARK_WEBHOOK_USERNAME=postmark
POSTMARK_WEBHOOK_PASSWORD=replace_with_long_random_value
