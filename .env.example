# OptiNexus container runtime: copy to .env (never commit it). Compose reads this file for ${...} interpolation only; the containers get
# exactly the values passed in docker-compose.yml. After changing a value run `docker compose up -d`; no image rebuild is needed.
#
# Required (Compose refuses to start without them):
#   APP_KEY      base64: + 32 random bytes, e.g.  echo "base64:$(openssl rand -base64 32)"
#                (PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); "base64:" + [Convert]::ToBase64String($b))
#   DB_PASSWORD  a long random string
APP_KEY=
DB_PASSWORD=

# Public base URL browsers use for the OptiNexus API / OIDC provider. It is the OIDC issuer, so every product and every container must be able
# to resolve it too (see deploy/ecosystem for the multi-product setup). Origin only: no path, no trailing slash.
NEXUS_PUBLIC_URL=http://localhost:8100

# Bootstrap administrator, created once by the bootstrap job (an existing password is never overwritten unless CGO_SUPERADMIN_RESET_PASSWORD=true).
CGO_SUPERADMIN_EMAIL=superadmin@cgo.local
CGO_SUPERADMIN_PASSWORD=
CGO_SUPERADMIN_RESET_PASSWORD=false
# catalog = permissions, roles, administrator, application and event catalogs; demo = also demo customers/users; none = skip seeding.
NEXUS_SEED=catalog

# Host ports and the address they are published on (127.0.0.1 = this machine only).
BIND_ADDRESS=127.0.0.1
NEXUS_API_PORT=8100
NEXUS_UI_PORT=5180

# Optional
APP_ENV=production
APP_DEBUG=false
DB_DATABASE=optinexus
DB_USERNAME=optinexus
CLIENT_MAX_BODY_SIZE=20m
OPTIRADAR_SYNC_ENABLED=false
OPTIRADAR_BASE_URL=
OPTIRADAR_API_TOKEN=

# Mail for invitation e-mails (runtime settings; the password is a secret: keep it in this untracked file or your secret store).
# MAIL_MAILER=log delivers nothing. Use smtp with your provider's host/port/credentials; MAIL_SCHEME=smtps for implicit TLS (port 465).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=OptiNexus
INVITATION_TTL_HOURS=72
# Set to false once every product uses invitations: switches off the deprecated direct user creation (DECISION_PACKAGE.md item 3).
NEXUS_DELEGATION_DIRECT_USERS=true
